# GEMINI_API_KEY: Required for server-side Gemini AI Retina Explain responses.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ML_BACKEND_URL: Optional external Python/PyTorch retinal inference microservice URL.
# When omitted, RETINA-XAI runs in clearly labeled Prototype / Demonstration mode.
ML_BACKEND_URL=""
